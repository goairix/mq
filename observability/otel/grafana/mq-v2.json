      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, topic, subscription) (rate(mq_consume_duration_seconds_bucket{topic=~\"$topic\",subscription=~\"$subscription\"}[$__rate_interval])))",
          "legendFormat": "{{topic}} / {{subscription}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
