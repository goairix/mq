        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "批次最老消息年龄 p95",
      "type": "timeseries",
      "description": "从消息 CreatedAt 到 handler 开始；延时消息包含计划等待时间。只在消费时有样本，不能替代 broker lag。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, topic, subscription) (rate(mq_consume_oldest_age_seconds_bucket{topic=~\"$topic\",subscription=~\"$subscription\"}[$__rate_interval)))",
          "legendFormat": "{{topic}} / {{subscription}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
